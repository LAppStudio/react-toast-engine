{
  "name": "@lapp-studio/react-toast-engine",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/core.cjs",
  "module": "dist/core.js",
  "types": "dist/core.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    },
    "./native/reanimated": {
      "import": {
        "types": "./dist/native-reanimated.d.ts",
        "default": "./dist/native-reanimated.js"
      },
      "require": {
        "types": "./dist/native-reanimated.d.cts",
        "default": "./dist/native-reanimated.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    },
    "./web/motion": {
      "import": {
        "types": "./dist/web-motion.d.ts",
        "default": "./dist/web-motion.js"
      },
      "require": {
        "types": "./dist/web-motion.d.cts",
        "default": "./dist/web-motion.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:pkg": "publint --pack npm && attw --pack . --profile node16",
    "audit:bundle": "yarn build && node scripts/audit-bundle.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^30.1.3",
    "motion": "^14.9.0",
    "publint": "^0.3.25",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-native": "~0.83.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-worklets": "~0.7.2",
    "tsdown": "^0.21.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "motion": ">=11.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.74.0",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-reanimated": "^4.0.0",
    "react-native-worklets": ">=0.5.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  },
  "maintainers": [
    "giovanninp"
  ],
  "keywords": [
    "react",
    "react-native",
    "toast",
    "notification",
    "snackbar",
    "alert",
    "headless",
    "zustand",
    "reanimated",
    "gesture-handler",
    "ui",
    "hybrid"
  ],
  "license": "MIT"
}
